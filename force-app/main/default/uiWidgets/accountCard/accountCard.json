                      "children": [
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "Annual revenue",
                            "variant": "body",
                            "weight": "semibold"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$attrs.annualRevenue}",
                            "variant": "body"
                          }
                        }
                      ]
                    },
                    {
                      "definition": "tile/row",
