                {
                  "definition": "tile/text",
                  "attributes": {
                    "text": "{!$attrs.accountName}",
                    "variant": "h2"
                  }
                },
                {
                  "definition": "tile/row",
                  "attributes": { "gap": "sm" },
                  "children": [
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "{!$attrs.industry}",
                        "variant": "caption",
                        "color": "muted"
                      }
                    },
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "•",
                        "variant": "caption",
                        "color": "muted"
                      }
                    },
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "{!$attrs.accountType}",
                        "variant": "caption",
                        "color": "muted"
                      }
                    },
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "•",
                        "variant": "caption",
                        "color": "muted"
                      }
                    },
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "{!$attrs.rating}",
                        "variant": "caption",
                        "color": "muted"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "definition": "tile/container",
              "children": [
                {
                  "definition": "tile/column",
                  "attributes": { "gap": "sm" },
