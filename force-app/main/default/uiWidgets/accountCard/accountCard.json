                      "children": [
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "Employees",
                            "variant": "body",
                            "weight": "semibold"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$attrs.numberOfEmployees}",
                            "variant": "body"
                          }
                        }
                      ]
                    },
                    {
                      "definition": "tile/row",
                      "attributes": { "gap": "sm" },
                      "children": [
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "Phone",
                            "variant": "body",
                            "weight": "semibold"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$attrs.phone}",
                            "variant": "body"
                          }
                        }
                      ]
                    },
                    {
                      "definition": "tile/row",
                      "attributes": { "gap": "sm" },
                      "children": [
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "Website",
                            "variant": "body",
                            "weight": "semibold"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$attrs.website}",
                            "variant": "body"
                          }
                        }
                      ]
                    },
                    {
                      "definition": "tile/row",
                      "attributes": { "gap": "sm" },
                      "children": [
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "Owner",
                            "variant": "body",
                            "weight": "semibold"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$attrs.ownerName}",
                            "variant": "body"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "definition": "tile/container",
              "children": [
                {
                  "definition": "tile/column",
                  "attributes": { "gap": "sm" },
                  "children": [
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "Contacts",
                        "variant": "h3",
                        "weight": "semibold"
                      }
                    },
                    {
                      "definition": "tile/container",
                      "meta": {
                        "forEach": "{!$attrs.contacts}",
                        "forItem": "$contact"
                      },
                      "children": [
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$contact.contactName}",
                            "variant": "body",
                            "weight": "semibold"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$contact.title}",
                            "variant": "caption",
                            "color": "muted"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$contact.email}",
                            "variant": "caption"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$contact.phone}",
                            "variant": "caption"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  }
